{
  "name": "rabbit-desktop-pet",
  "version": "1.1.0",
  "description": "Photorealistic rabbit desktop pet for Windows and macOS",
  "homepage": "https://github.com/zdjmrq/rabbit-desktop-pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/zdjmrq/rabbit-desktop-pet.git"
  },
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "dist": "npm run check && npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run check && npm run build && electron-builder --mac zip --arm64 --publish never"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/three": "^0.179.0",
    "electron": "42.9.0",
    "electron-builder": "^26.0.12",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.zdjmrq.rabbitpet",
    "productName": "写实小兔子桌宠",
    "artifactName": "RabbitDesktopPet-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "dist/renderer.js",
      "assets/rabbit-idle.png",
      "package.json"
    ],
    "win": { "target": ["portable"] },
    "portable": { "artifactName": "RabbitDesktopPet-${version}-portable.${ext}" },
    "mac": {
      "target": [{ "target": "zip", "arch": ["arm64"] }],
      "artifactName": "RabbitDesktopPet-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.entertainment",
      "icon": "build/RabbitDesktopPet.icns",
      "identity": null,
      "hardenedRuntime": false
    }
  }
}
